Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Antigravity Assistant & PGP Lab
    Version 2.1
    Description Unified Splicing Predictor & Genomic Variant Annotation Pipeline Container (GRCh38)
    Build.Date 2026-09-04

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export DEBIAN_FRONTEND=noninteractive
    export PATH=/opt/conda/bin:$PATH
    export PYTHONPATH=/opt/Pangolin:$PYTHONPATH
    export TF_ENABLE_ONEDNN_OPTS=0

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        wget \
        curl \
        git \
        bzip2 \
        ca-certificates \
        libglib2.0-0 \
        libxext6 \
        libsm6 \
        libxrender1 \
        libbz2-dev \
        liblzma-dev \
        zlib1g-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libncurses5-dev \
        r-base \
        r-base-dev \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Create host mount target directories
    mkdir -p /data_lab_PGP /references /home/mruizp

    # Install Miniforge / Mamba
    wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh
    export PATH=/opt/conda/bin:$PATH

    # Install Python packages and Bioinformatics Tools
    mamba install -y -c pytorch -c conda-forge -c bioconda -c defaults \
        python=3.10 \
        pip \
        "setuptools<70" \
        "htslib>=1.19" \
        "bcftools>=1.19" \
        "samtools>=1.19" \
        tabix \
        pysam \
        pyvcf3 \
        "numpy<2.0" \
        pandas \
        pyarrow \
        openpyxl \
        biopython \
        pyliftover \
        scikit-learn \
        scipy \
        plotly \
        pytorch \
        cpuonly

    # Install SpliceAI and TensorFlow
    pip install --no-cache-dir \
        tensorflow==2.15.1 \
        spliceai==1.3.1

    # Install R packages for SPiP and Static Plotting
    R -e "install.packages(c('randomForest', 'optparse', 'stringr', 'data.table', 'ggplot2', 'dplyr', 'tidyr'), repos='https://cloud.r-project.org/')"

    # Clone Pangolin Repository
    git clone https://github.com/tkzeng/Pangolin.git /opt/Pangolin
    pip install --no-cache-dir -e /opt/Pangolin || true

    # Clean up conda cache
    conda clean -a -y

%runscript
    exec "$@"
