// Nextflow configuration. `standard` = SGE + Singularity (production); `local_dev` = local
// environments, for -stub-run testing only.

params {
    // Cluster paths (production).
    data_lab_pgp    = '/data_lab_PGP'
    references_dir  = '/references'
    shared_utils    = "${params.data_lab_pgp}/shared/utils"

    // SpliceAI and shared tools.
    python_spliceai = "${params.shared_utils}/conda_envs/spliceai_env/bin/python3"
    bcftools        = "${params.shared_utils}/conda_envs/genomics/bin/bcftools"
    tabix           = "${params.shared_utils}/conda_envs/genomics/bin/tabix"
    bgzip           = "${params.shared_utils}/conda_envs/genomics/bin/bgzip"
    fasta           = "${params.references_dir}/genomes/Homo_sapiens/GATK_bundle/v0/Homo_sapiens_assembly38.fasta"

    split_vcf_chunks_script  = "${projectDir}/src/python/split_vcf_chunks.py"
    annotate_spliceai_script = "${projectDir}/src/python/annotate_spliceai.py"

    // SpliceAI -D: maximum distance (bp) between a variant and the splice site it scores.
    spliceai_distance = 4999
    chunk_size        = 20000

    // Gene-restricted tier chunk size; smaller because SpliceAI/Pangolin chunk runtime varies widely.
    gene_restricted_chunk_size = 8000

    // Pangolin.
    pangolin_python   = "${params.shared_utils}/conda_envs/pangolin_env/bin/python3"
    pangolin_repo     = "${projectDir}/src/external/Pangolin-main"
    // GENCODE 45 (Ensembl 111, same gene models as the VEP cache), Ensembl_canonical genes.
    // Build: walkthrough/20260930_pangolin_db_gencode_v45_rebuild.md.
    pangolin_db       = "${params.shared_utils}/pangolin_db/gencode.v45.ensembl_canonical.grch38.db"
    pangolin_distance = 4999

    // SPiP; --maxLines is passed to SPiPv2.1_main.r.
    spip_rscript  = "${params.shared_utils}/conda_envs/spip_env/bin/Rscript"
    spip_script   = "${params.data_lab_pgp}/resources/annotation/SPiP/SPiPv2.1_main.r"
    spip_max_lines = 22000

    // Tier SPiP runs in: 'restricted' (default) or 'broad'.
    spip_tier = 'restricted'

    // VEP, run in the container below (see the `standard` profile).
    vep_sif            = "${params.data_lab_pgp}/resources/sif_images/vep.sif"
    vep_dir            = "${params.references_dir}/genomes/Homo_sapiens/annotations/VEP/GRCh38"
    vep_plugins_dir    = "${params.vep_dir}/plugins"
    vep_cache_version  = 111
    // Provenance stamp JSON stored in the Parquet footer of the published tables; set by run_annotate_vcf.sh
    // (pipeline_info/TABLE_STAMP.json). Empty: no stamp.
    provenance_stamp   = null

    // ClinVar GRCh38 VCF used as a VEP --custom source; the file name carries the release date.
    clinvar_vcf        = "${params.data_lab_pgp}/resources/annotation/clinvar/GRCh38/clinvar_20260928.vcf.gz"
    // Every database file VEP reads, one param each, so the run manifest can describe them.
    vep_cadd            = "${params.vep_plugins_dir}/CADD/v1.7/GRCh38/whole_genome_SNVs.tsv.gz"
    vep_utrannotator    = "${params.vep_plugins_dir}/UTRAnnotator/uORF_5UTR_GRCh38_PUBLIC.txt"
    vep_spliceai_snv    = "${params.vep_plugins_dir}/spliceAI/spliceai_scores.raw.snv.hg38.vcf.gz"
    vep_spliceai_indel  = "${params.vep_plugins_dir}/spliceAI/spliceai_scores.raw.indel.hg38.vcf.gz"
    vep_revel           = "${params.vep_plugins_dir}/REVEL/GRCh38/new_tabbed_revel_grch38.tsv.gz"
    vep_mastermind      = "${params.vep_plugins_dir}/MasterMind/mastermind_cited_variants_reference-2024.07.03-grch38.vcf.gz"
    vep_loftool         = "${params.vep_plugins_dir}/LoFtool/LoFtool_scores.txt"
    vep_pli             = "${params.vep_plugins_dir}/pLI/plI_gene.txt"
    vep_dbnsfp          = "${params.vep_plugins_dir}/dbNSFP/dbNSFP4.8a_grch38.gz"
    vep_dbnsfp_fields   = "${projectDir}/resources/vep_dbnsfp_fields.txt"
    vep_alphamissense   = "${params.vep_plugins_dir}/AlphaMissense/AlphaMissense_hg38.tsv.gz"
    vep_maxentscan_dir  = "${params.vep_plugins_dir}/MaxEntScan/download/fordownload"
    splicevardb_vcf     = "${params.references_dir}/genomes/Homo_sapiens/annotations/splicevardb/splicevardb.to.annotate.tsv.vcf.gz"
    splicevault_file    = "${params.data_lab_pgp}/resources/annotation/SpliceVault/SpliceVault_data_GRCh38.tsv.gz"
    gnomad_vcf          = "${params.references_dir}/genomes/Homo_sapiens/annotations/gnomAD/GRCh38/v4.1/gnomAD.v4.1.vcf.gz"
    // ReMM v0.4 hg38 per-position score (bigWig), read by VEP --custom; informational only.
    vep_remm            = "${params.data_lab_pgp}/resources/annotation/ReMM/v0.4/ReMM.v0.4.hg38.bw"
    // AlphaGenome AVI SNV scores (tabix TSV), read by the VEP AVI plugin; informational only.
    vep_avi             = "${params.data_lab_pgp}/resources/annotation/AlphaGenome/AVI/avi_scores_snvs_tabix/alphagenome_variant_impact_score_snvs.tsv.gz"

    // Branchpointer + LaBranchoR.
    branchpointer_python = "${params.shared_utils}/conda_envs/spliceai_env/bin/python3"
    branchpointer_script = "${projectDir}/src/python/annotate_branchpointer.py"
    labranchor_bed        = "${params.data_lab_pgp}/resources/annotation/labranchor/labranchor_grch38_top.bed.gz"

    // VCF-to-table. The parser is vendored in src/python/parsing/ (see its PROVENANCE.md) and resolves
    // logger.py and modules/ from its own directory.
    vcf_parser_python     = "${params.shared_utils}/conda_envs/vcf_parser/bin/python"
    datasci_python        = "${params.shared_utils}/conda_envs/datasci/bin/python3"
    vcf_parser_script     = "${projectDir}/src/python/parsing/vcf_parser_pysam.py"
    filter_variants_script = "${projectDir}/src/python/parsing/filter_variants.py"
    vep_cols_file         = "${projectDir}/resources/all_but_old_gnomad_vep_cols.txt"
    // Gene/transcript identity for attaching SpliceAI / Pangolin / SPiP scores to the row's own gene or
    // transcript (src/python/parsing/modules/gene_identity.py). Both are REQUIRED: filter_variants.py
    // refuses to fall back to unmatched scores. hgnc_table is a manual deployment (HGNC complete set,
    // file dated 2026-09-29, sha256 91d0ad20...9d889e); spliceai_symbol_map is built by
    // src/python/build_gene_identity_tables.py and committed (manifest beside it).
    hgnc_table            = "${params.data_lab_pgp}/resources/annotation/hgnc/hgnc_complete_set.2026-09-29.txt"
    spliceai_symbol_map   = "${projectDir}/resources/spliceai_symbol_to_ensg.grch38.gencode45.tsv"
    enst_spip_map           = "${projectDir}/resources/enst_to_spip_nm.grch38.gencode45.tsv"   // built by src/python/build_enst_spip_map.py
    // Disease-gene curation list (GENE, NAME, SOURCE, EVIDENCE); TSV_TO_TABLE fails when it is missing.
    disease_gene_list     = "${params.shared_utils}/data/Complete_gene_list_V4.csv"
    // dbNSFP columns whose '&' lists align with Ensembl_transcriptid (src/tools/derive_dbnsfp_dependency.py)
    dbnsfp_aligned_columns  = "${projectDir}/resources/dbnsfp_transcript_aligned_columns.txt"
    // site-packages of the vcf_parser env: cluster path, then the local alias.
    vcf_parser_pythonpath = "${params.shared_utils}/conda_envs/vcf_parser/lib/python3.13/site-packages:/home/mruizp/data_lab_PGP/shared/utils/conda_envs/vcf_parser/lib/python3.13/site-packages"
    output_format         = 'pq'
    table_chunk_rows      = 250000   // TSV_TO_TABLE processes the TSV this many rows at a time (Parquet output); 0 loads it whole

    // Gene-restricted tier regions, built by src/python/build_gene_restriction_bed.py.
    gene_restriction_bed  = "${projectDir}/resources/v5_genes_loc.bed"
    gene_transcript_priority_script = "${projectDir}/src/python/tag_transcript_priority.py"

    // Pre-flight input check (src/python/check_vcf_assembly.py). A VCF called against params.fasta has
    // 0 REF mismatches; the 1% ceiling tolerates a few odd records on a WGS input.
    check_assembly_python          = "${params.shared_utils}/conda_envs/spliceai_env/bin/python3"
    check_assembly_script          = "${projectDir}/src/python/check_vcf_assembly.py"
    assembly_ref_check_records     = 1000
    assembly_max_ref_mismatch_frac = 0.01
    assembly_min_ref_checked       = 20   // only applies when the VCF has no ##contig lengths
    input_max_multiallelic         = 0    // multiallelic records allowed before the check fails
    input_max_unnormalised         = 0    // not left-aligned / non-parsimonious records allowed

    // Genotype outputs (src/python/extract_genotypes.py, src/python/genotypes_to_wide.py).
    genotypes                 = 'auto'   // 'off' skips the long genotype table
    extract_genotypes_script  = "${projectDir}/src/python/extract_genotypes.py"
    genotypes_wide_script     = "${projectDir}/src/python/genotypes_to_wide.py"
    genotype_wide             = false    // also write <run_id>.parsed.clean.withGT.<fmt> with GT_<sample> columns
    genotype_wide_max_samples = 10       // the wide view fails above this many samples

    // Input VCF (bgzipped, with .tbi) and the output root.
    input_vcf  = null
    outdir     = "${projectDir}/nf_work/annotation_out"

    // Output folder name; null falls back to the input file name.
    run_id     = null

    // Sub-folders of <outdir>/<run_id>/ that each module publishes into.
    out_subdir = [
        annotation : 'annotation',     // merged annotated VCF
        predictors : 'predictors',     // per-predictor VCFs
        tables     : 'tables',         // parsed tables
        genotypes  : 'genotypes',      // long genotype table
        reports    : 'reports',        // input-check report
        info       : 'pipeline_info'   // manifest, Nextflow trace / timeline / report / log
    ]

    // <outdir>/<run_id>/pipeline_info and the launch timestamp that names its Nextflow reports.
    // run_id falls back to the input filename without .gz / .vcf (the launcher's rule).
    pipeline_info_dir = "${params.outdir}/${params.run_id ?: (params.input_vcf ? new File(params.input_vcf.toString()).name.replaceAll(/\.gz$/, '').replaceAll(/\.vcf$/, '') : 'unnamed')}/${params.out_subdir.info}"
    report_timestamp  = new Date().format('yyyy-MM-dd_HH-mm-ss')

    sge_project    = 'BIGN'
    sge_accounting = 'PGP'

    // Hosts excluded from SPLICEAI_ANNOTATE and PANGOLIN_ANNOTATE (added as `-l h=!host`); [] disables.
    long_task_excluded_hosts = ['c0053-cn1', 'c0051-cn1']
}

// Nextflow execution reports, one timestamped set per launch.
trace {
    enabled = true
    file    = "${params.pipeline_info_dir}/execution_trace_${params.report_timestamp}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,cpus,%cpu,memory,peak_rss,peak_vmem,hostname,workdir'
}
timeline {
    enabled = true
    file    = "${params.pipeline_info_dir}/execution_timeline_${params.report_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.pipeline_info_dir}/execution_report_${params.report_timestamp}.html"
}

process {
    errorStrategy = 'retry'
    maxRetries    = 5

    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { Math.min(4 * task.attempt, 12) }
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    // PANGOLIN_ANNOTATE/SPLICEAI_ANNOTATE: wall-clock bound, so only `time` is wider than process_medium.
    withLabel: process_long {
        cpus       = { Math.min(4 * task.attempt, 12) }
        memory     = { 12.GB * task.attempt }
        time       = { 24.h * task.attempt }
    }
    // Pangolin chunks get a longer time limit than the process_long default.
    withName: 'PANGOLIN_ANNOTATE' {
        time = { 36.h * task.attempt }
    }
    // First-attempt memory for the whole-table steps, sized from the F2005_union run (23.7 M rows).
    withName: 'TSV_TO_TABLE' {
        memory = { 48.GB + 24.GB * (task.attempt - 1) }
        time   = { 12.h * task.attempt }
    }
    withName: 'ADD_WIDE_GENOTYPES' {
        memory = { 24.GB + 12.GB * (task.attempt - 1) }
    }
    withName: 'TAG_TRANSCRIPT_PRIORITY' {
        memory = { 24.GB + 12.GB * (task.attempt - 1) }
    }
    withLabel: process_single {
        cpus   = 1
        // 8 GB from attempt 1 and a 1 h limit, so a hung first attempt is retried after 1 h.
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}

profiles {
    // Production: SGE. Each h_vmem request is paired with the task's memory= directive.
    standard {
        workDir = '/mnt/scratch/mruizp/annotation_pipeline_new/work'
        process.executor = 'sge'
        process.penv     = 'smp'
        process.clusterOptions = {
            def hostExclusion = (params.long_task_excluded_hosts && task.process =~ /(SPLICEAI|PANGOLIN)_ANNOTATE$/)
                ? " -l h=" + params.long_task_excluded_hosts.collect { "!${it}" }.join('&')
                : ''
            "-v TMPDIR=/data_tmp -S /bin/bash -P ${params.sge_project} -A ${params.sge_accounting} -l h_vmem=${Math.max(12, task.memory.toGiga() + 10)}G" + hostExclusion
        }

        // Applies to VEP_ANNOTATE, the only process with a container. --cleanenv keeps host
        // PERL5LIB/PYTHONPATH out; the binds expose the reference and data paths.
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "--cleanenv --bind ${System.getenv('HOME')}:${System.getenv('HOME')} --bind /data_tmp:/tmp --bind ${params.references_dir}:${params.references_dir} --bind ${params.data_lab_pgp}:${params.data_lab_pgp}"
    }

    // Local -stub-run testing only, with a local exec-capable miniforge3 install.
    local_dev {
        process.executor = 'local'

        params.python_spliceai = '/home/mruizp/apps/miniforge3/envs/spliceai_env/bin/python3'
        params.bcftools        = '/home/mruizp/apps/miniforge3/envs/genomics/bin/bcftools'
        params.tabix           = '/home/mruizp/apps/miniforge3/envs/genomics/bin/tabix'
        params.bgzip           = '/home/mruizp/apps/miniforge3/envs/genomics/bin/bgzip'
        // Local GRCh38 FASTA. The local spliceai_env cannot run real inference; use -stub-run.
        params.fasta             = '/home/mruizp/data_references/genomes/Homo_sapiens/GATK_bundle/v0/Homo_sapiens_assembly38.fasta'

        // Pangolin, SPiP and VEP have no local environment and keep their cluster paths (stub only).
        params.branchpointer_python = '/home/mruizp/apps/miniforge3/envs/spliceai_env/bin/python3'
        params.check_assembly_python = '/home/mruizp/apps/miniforge3/envs/spliceai_env/bin/python3'

        params.vcf_parser_python = '/home/mruizp/apps/miniforge3/envs/vcf_parser/bin/python'
        params.datasci_python    = '/home/mruizp/apps/miniforge3/envs/datasci/bin/python3'
        params.vcf_parser_pythonpath = '/home/mruizp/apps/miniforge3/envs/vcf_parser/lib/python3.13/site-packages'
    }
}
