// Nextflow orchestration for annotation_pipeline_new — Phase 1 (SpliceAI) + Phase 2
// (Pangolin, SPiP) of the gene-restricted tier + Phase 3 (VEP, Branchpointer) broad tier.
// Scope: see /home/mruizp/.claude/plans/scalable-wibbling-snowflake.md
//
// Production always runs on the SGE HPC cluster (confirmed by user, 2026-09-21) — the default
// profile below targets that. The `local_dev` profile exists only so this stage can be exercised
// from a workstation/sandbox without cluster access; it is not a supported deployment mode of the
// real pipeline and is not wired into main.sh.

params {
    // ----------------- Cluster-default paths (production) -----------------
    // Mirrors config/env.sh's resolution order for the paths this Phase-1 spike needs.
    data_lab_pgp    = '/data_lab_PGP'
    references_dir  = '/references'
    shared_utils    = "${params.data_lab_pgp}/shared/utils"

    // SpliceAI stage inputs — same binaries/paths annotate_spliceai_vars.sh resolves today.
    python_spliceai = "${params.shared_utils}/conda_envs/spliceai_env/bin/python3"
    bcftools        = "${params.shared_utils}/conda_envs/genomics/bin/bcftools"
    tabix           = "${params.shared_utils}/conda_envs/genomics/bin/tabix"
    bgzip           = "${params.shared_utils}/conda_envs/genomics/bin/bgzip"
    fasta           = "${params.references_dir}/genomes/Homo_sapiens/GATK_bundle/v0/Homo_sapiens_assembly38.fasta"

    split_vcf_chunks_script  = "${projectDir}/src/python/split_vcf_chunks.py"
    annotate_spliceai_script = "${projectDir}/src/python/annotate_spliceai.py"

    // Unchanged from today's pipeline (main.sh/annotate_spliceai_vars.sh) — not touched by this
    // migration; see plan's "explicit non-goals" (-D 4999 fix tracked separately in TODO.md).
    spliceai_distance = 10000
    chunk_size        = 20000
    chunk_threshold   = 15000   // below this record count, skip chunking (matches CHUNK_THRESHOLD)

    // Gene-restricted-tier-specific chunk size (SpliceAI/Pangolin/SPiP), separate from the broad
    // tier's `chunk_size` above: these two predictors' per-chunk runtime is highly variable
    // (minutes to many hours) at this record count, unlike VEP/Branchpointer. Smaller chunks
    // reduce per-chunk worst-case wall-clock exposure.
    gene_restricted_chunk_size = 8000

    // Pangolin stage inputs — same binaries/paths annotate_pangolin_vars.sh resolves today.
    // No chunking: main.sh runs Pangolin on the whole per-gene VCF (main.sh:458-463).
    pangolin_python   = "${params.shared_utils}/conda_envs/pangolin_env/bin/python3"
    pangolin_repo     = "${projectDir}/src/external/Pangolin-main"
    // GENCODE 45 (Ensembl 111, same gene models as the VEP 111 cache), Ensembl_canonical filter.
    // Replaces pangolin_grch38.db, which is a mouse annotation (MISC-12). Build provenance:
    // walkthrough/20260930_pangolin_db_gencode_v45_rebuild.md.
    pangolin_db       = "${params.shared_utils}/pangolin_db/gencode.v45.ensembl_canonical.grch38.db"
    pangolin_distance = 10000

    // SPiP stage inputs — same binaries/paths annotate_spip_vars.sh resolves today. Also no
    // chunking at the orchestration level (main.sh:420-429); --maxLines is an internal detail of
    // SPiPv2.1_main.r itself, kept verbatim as a non-goal.
    spip_rscript  = "${params.shared_utils}/conda_envs/spip_env/bin/Rscript"
    spip_script   = "${params.data_lab_pgp}/resources/annotation/SPiP/SPiPv2.1_main.r"
    spip_max_lines = 22000

    // Tier placement for SPiP is unresolved (no profiling data exists yet) — defaulted to
    // 'restricted' per the user's explicit choice at plan approval, matching today's behavior.
    spip_tier = 'restricted'

    // VEP stage inputs — same paths annotate_vep_vars.sh resolves today. Containerized (see
    // `standard` profile's singularity block below) rather than a bare binary path, since VEP
    // already ran inside vep.sif in the bash pipeline (annotate_vep_vars.sh:33-37).
    vep_sif            = "${params.data_lab_pgp}/resources/sif_images/vep.sif"
    vep_dir            = "${params.references_dir}/genomes/Homo_sapiens/annotations/VEP/GRCh38"
    vep_plugins_dir    = "${params.vep_dir}/plugins"
    vep_cache_version  = 111

    // Branchpointer + LaBranchoR stage inputs — same paths annotate_branchpointer_vars.sh
    // resolves today. No chunking: main.sh runs it on the whole per-gene VCF (main.sh:488-497).
    branchpointer_python = "${params.shared_utils}/conda_envs/spliceai_env/bin/python3"
    branchpointer_script = "${projectDir}/src/python/annotate_branchpointer.py"
    labranchor_bed        = "${params.data_lab_pgp}/resources/annotation/labranchor/labranchor_grch38_top.bed.gz"

    // VCF-to-table stage inputs. vcf_parser_pysam.py/filter_variants.py are vendored in this repo
    // (src/python/parsing/, verbatim copy of shared/utils@19925ed — see its PROVENANCE.md); they
    // resolve logger.py and modules/ from their own directory (sys.path[0]), not via PYTHONPATH.
    vcf_parser_python     = "${params.shared_utils}/conda_envs/vcf_parser/bin/python"
    datasci_python        = "${params.shared_utils}/conda_envs/datasci/bin/python3"
    vcf_parser_script     = "${projectDir}/src/python/parsing/vcf_parser_pysam.py"
    filter_variants_script = "${projectDir}/src/python/parsing/filter_variants.py"
    vep_cols_file         = "${projectDir}/resources/all_but_old_gnomad_vep_cols.txt"
    // Gene/transcript identity for attaching SpliceAI / Pangolin / SPiP scores to the row's own gene or
    // transcript (src/python/parsing/modules/gene_identity.py). Both are REQUIRED: filter_variants.py
    // refuses to fall back to unmatched scores. hgnc_table is a manual deployment (HGNC complete set,
    // file dated 2026-09-29, sha256 91d0ad20...9d889e); spliceai_symbol_map is built by
    // src/python/build_gene_identity_tables.py and committed (manifest beside it).
    hgnc_table            = "${params.data_lab_pgp}/resources/annotation/hgnc/hgnc_complete_set.2026-09-29.txt"
    spliceai_symbol_map   = "${projectDir}/resources/spliceai_symbol_to_ensg.grch38.gencode45.tsv"
    gene_transcript_mapping = "${projectDir}/resources/gene_transcript_mapping.txt"
    // Ported verbatim from vcf2parsed.sh's own two-candidate hardcoded path (cluster + local
    // fallback) — belt-and-suspenders in case the vcf_parser env's own site-packages doesn't
    // already resolve correctly for VCF_PARSER_PYTHON.
    vcf_parser_pythonpath = "${params.shared_utils}/conda_envs/vcf_parser/lib/python3.13/site-packages:/home/mruizp/data_lab_PGP/shared/utils/conda_envs/vcf_parser/lib/python3.13/site-packages"
    output_format         = 'pq'

    // Whole-VCF entry point (annotate_vcf.nf) — gene-restricted tier's region-restriction filter.
    // Built by src/python/build_gene_restriction_bed.py from Complete_gene_list_V5 + the local
    // MANE GTF (BUG_TRACKER.md MISC-4 tracks its known coverage gaps).
    gene_restriction_bed  = "${projectDir}/resources/v5_genes_loc.bed"
    gene_transcript_priority_script = "${projectDir}/src/python/tag_transcript_priority.py"

    // Whole-VCF pre-flight assembly check (MISC-14, src/python/check_vcf_assembly.py). A VCF called
    // against params.fasta has 0 REF mismatches; one from another assembly mismatches at most
    // records. The 1% ceiling separates the two without failing a WGS run on a single odd record.
    check_assembly_python          = "${params.shared_utils}/conda_envs/spliceai_env/bin/python3"
    check_assembly_script          = "${projectDir}/src/python/check_vcf_assembly.py"
    assembly_ref_check_records     = 1000
    assembly_max_ref_mismatch_frac = 0.01
    assembly_min_ref_checked       = 20   // only applies when the VCF has no ##contig lengths

    // Required input for this spike: one gene's pre-SpliceAI VCF.gz (today's
    // $TMP_MASTER_DIR/${gene_name}.vcf.gz shape) and where to write the annotated output.
    input_vcf  = null
    outdir     = "${projectDir}/nf_work/annotation_out"

    // Whole-VCF entry point only (annotate_vcf.nf) — overrides the input-filename-derived run_id
    // (BUG_TRACKER.md MISC-7). null by default: annotate_vcf.nf falls back to the filename.
    run_id     = null

    sge_project    = 'BIGN'
    sge_accounting = 'PGP'
}

process {
    errorStrategy = 'retry'
    maxRetries    = 5

    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { Math.min(4 * task.attempt, 12) }
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    // For PANGOLIN_ANNOTATE/SPLICEAI_ANNOTATE only — wall-clock, not memory, is their limiting
    // resource, so only `time` is widened relative to process_medium; cpu/memory scaling matches
    // it. maxRetries was originally set to 2 on the assumption 24h/48h covers any real chunk;
    // real evidence on S223 contradicted that (a chunk still running past 46h on attempt 2, right
    // at the 48h ceiling) — reverted to the global default.
    withLabel: process_long {
        cpus       = { Math.min(4 * task.attempt, 12) }
        memory     = { 12.GB * task.attempt }
        time       = { 24.h * task.attempt }
    }
    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
}

profiles {
    // Production target. Paths above are already cluster-absolute; this just wires the executor.
    // NOTE: every clusterOptions h_vmem bump is paired with an explicit memory= directive above
    // (see sarek_pipeline/configFiles/gemini_explanation_memoryhrss.txt — h_vmem alone without a
    // matching memory=/h_rss reservation causes silent disk-thrashing instead of a clean retry).
    standard {
        process.executor = 'sge'
        process.penv     = 'smp'
        process.clusterOptions = {
            "-v TMPDIR=/data_tmp -S /bin/bash -P ${params.sge_project} -A ${params.sge_accounting} -l h_vmem=${Math.max(12, task.memory.toGiga() + 10)}G"
        }

        // VEP_ANNOTATE is the only process with a `container` directive so far (Phase 3) — this
        // only takes effect for that process; every other process ignores it. Bind mounts mirror
        // annotate_vep_vars.sh:33-37's manual `singularity exec --bind ...` flags exactly, since
        // VEP's cache/plugin paths under /references and /data_lab_PGP are absolute host paths
        // the container has no reason to see otherwise. `--cleanenv` also carried over from that
        // same call (bash's `-e` flag) — without it, host PERL5LIB/PYTHONPATH leak into the
        // container and can break VEP plugin loading in confusing, hard-to-reproduce ways.
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "--cleanenv --bind ${System.getenv('HOME')}:${System.getenv('HOME')} --bind /data_tmp:/tmp --bind ${params.references_dir}:${params.references_dir} --bind ${params.data_lab_pgp}:${params.data_lab_pgp}"
    }

    // Local sandbox verification ONLY (this session has no cluster access and no exec permission
    // on the NFS-mounted /data_lab_PGP conda envs — confirmed 2026-09-21, mount is `noexec`).
    // Points at a separate, local, exec-capable miniforge3 install instead. Not for production use.
    local_dev {
        process.executor = 'local'

        params.python_spliceai = '/home/mruizp/apps/miniforge3/envs/spliceai_env/bin/python3'
        params.bcftools        = '/home/mruizp/apps/miniforge3/envs/genomics/bin/bcftools'
        params.tabix           = '/home/mruizp/apps/miniforge3/envs/genomics/bin/tabix'
        params.bgzip           = '/home/mruizp/apps/miniforge3/envs/genomics/bin/bgzip'
        // Real local GRCh38 FASTA (confirmed 2026-09-21, corrected an earlier wrong "not
        // present" finding caused by a transient NFS stall on the first check — path is correct
        // and readable). However, real end-to-end inference still can't run in THIS sandbox:
        // the local miniforge3 spliceai_env above has pandas 2.2.3 paired with an old spliceai
        // build that calls the removed `Series.get_values()` API — a stale local-env mismatch,
        // confirmed unrelated to the pipeline itself (a real prior production run,
        // RUNS/run_20260813_1028/annotation/MYBPC3.annSpliceAI.vcf.gz, has genuine non-trivial
        // SpliceAI scores, so the production spliceai_env is fine). Combine this profile with
        // -stub-run to validate the DAG/chunking mechanics without hitting that local env bug;
        // real model-score parity must be verified on the cluster with the production env.
        params.fasta             = '/home/mruizp/data_references/genomes/Homo_sapiens/GATK_bundle/v0/Homo_sapiens_assembly38.fasta'

        // Pangolin/SPiP (Phase 2): no local miniforge3 mirror of pangolin_env or spip_env exists
        // at all (confirmed 2026-09-21 — only spliceai_env/genomics were mirrored locally), so
        // unlike SpliceAI above, these two stages have NO real-execution path in this sandbox,
        // not even a version-mismatched one. PANGOLIN_ANNOTATE and SPIP_ANNOTATE can only be
        // exercised via -stub-run here; params.pangolin_python/pangolin_db/spip_rscript/
        // spip_script are left at their (locally non-executable) shared_utils/cluster-absolute
        // defaults deliberately, since there is no correct local substitute to point them at.

        // Branchpointer (Phase 3): unlike the other Phase 2/3 predictors, its only real dependency
        // is `pysam` (confirmed by reading src/python/annotate_branchpointer.py — no pandas/model
        // weights involved), and it reuses spliceai_env, which IS mirrored locally. Pointed at the
        // real local mirror deliberately, unlike Pangolin/SPiP above — this stage may be genuinely
        // runnable for real in this sandbox, not stub-only.
        params.branchpointer_python = '/home/mruizp/apps/miniforge3/envs/spliceai_env/bin/python3'
        params.check_assembly_python = '/home/mruizp/apps/miniforge3/envs/spliceai_env/bin/python3'

        // VEP (Phase 3): singularity.enabled is left at its default (false) in this profile, so
        // VEP_ANNOTATE's `container` directive is simply ignored here and -stub-run executes
        // directly on the host — no local pull of vep.sif is attempted. The full VEP cache/plugin
        // data tree under /references is also not fully mirrored locally (many plugin files beyond
        // the single FASTA), so this stage has no real-execution path in this sandbox regardless.

        // VCF_TO_TABLE (Phase 5): both vcf_parser and datasci envs ARE mirrored locally. The full
        // pipeline still can't exercise this stage for real end-to-end, since it needs a genuinely
        // VEP-annotated VCF (real CSQ field) and every upstream predictor is -stub-run-only here —
        // but the scripts themselves were verified separately against the known-good MYBPC3
        // reference (see walkthrough Phase 5 section), same as Branchpointer/merge before it.
        params.vcf_parser_python = '/home/mruizp/apps/miniforge3/envs/vcf_parser/bin/python'
        params.datasci_python    = '/home/mruizp/apps/miniforge3/envs/datasci/bin/python3'
        params.vcf_parser_pythonpath = '/home/mruizp/apps/miniforge3/envs/vcf_parser/lib/python3.13/site-packages'
    }
}
