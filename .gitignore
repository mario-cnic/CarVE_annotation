# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Large execution outputs and run directories
RUNS/
test_data/
_tmp/
_log/

# resources/ is for stable, curated reference data (gene/transcript maps,
# column dictionaries, container defs) only. Per-run outputs belong under
# RUNS/<RUN_NAME>/ (already ignored above), never here.
resources/run_*

# NFS "silly rename" artifacts left behind when a file is removed/moved
# while still open by another process
.nfs*
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.pq
*.parquet
*.tsv
*.xlsx
*.csv
!resources/**/*.tsv
!resources/**/*.txt
!resources/**/*.bed
!resources/**/*.yml
!resources/**/*.def
!resources/**/*.md

*.log
trash/
*.pdf

# Container binaries
*.sif

# Temporary and editor files
.DS_Store
.idea/
.vscode/
*.swp
